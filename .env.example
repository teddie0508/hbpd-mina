# Mật khẩu vào /customize. Đặt gì cũng được, miễn dài và khó đoán.
CUSTOMIZE_PASSWORD=

# Chuỗi ngẫu nhiên để ký cookie đăng nhập.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Vercel tự thêm khi bạn bật Blob Storage cho project.
# Để trống lúc chạy ở máy -> nội dung lưu vào .data/content.json
BLOB_READ_WRITE_TOKEN=
