# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# trừ file mẫu — không chứa giá trị nào, dùng làm tài liệu
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# nội dung soạn ở máy (chỉ dùng khi dev)
.data/

# ảnh/nhạc tải lên khi chạy ở máy
/public/uploads/
